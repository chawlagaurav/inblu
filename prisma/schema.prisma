// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  phone     String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  orders    Order[]

  @@map("users")
}

model Product {
  id           String      @id @default(uuid())
  slug         String?     @unique
  name         String
  description  String
  price        Decimal     @db.Decimal(10, 2)
  imageUrl     String      @map("image_url")
  images       String[]    @default([])
  sku          String?
  stock        Int         @default(0)
  category     String
  categories   String[]    @default([])
  specifications Json?     @default("{}")
  manualUrl    String?     @map("manual_url")
  serviceTenureMonths Int   @default(6) @map("service_tenure_months")
  relatedProductIds String[] @default([]) @map("related_product_ids")
  isBestSeller Boolean     @default(false) @map("is_best_seller")
  isActive     Boolean     @default(true) @map("is_active")
  isSoldOut    Boolean     @default(false) @map("is_sold_out")
  isOnSale     Boolean     @default(false) @map("is_on_sale")
  discountPercent Int?     @map("discount_percent")
  salePrice    Decimal?    @db.Decimal(10, 2) @map("sale_price")
  excludeFromCoupons Boolean @default(false) @map("exclude_from_coupons")
  displayOrder Int         @default(0) @map("display_order")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  orderItems   OrderItem[]
  inventoryTransactions InventoryTransaction[]

  @@map("products")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Order {
  id                  String        @id @default(uuid())
  userId              String?       @map("user_id")
  user                User?         @relation(fields: [userId], references: [id])
  customerName        String        @map("customer_name")
  email               String
  phone               String?
  totalAmount         Decimal       @db.Decimal(10, 2) @map("total_amount")
  subtotal            Decimal       @db.Decimal(10, 2)
  gst                 Decimal       @db.Decimal(10, 2)
  shippingCost        Decimal       @db.Decimal(10, 2) @map("shipping_cost")
  discountAmount      Decimal       @db.Decimal(10, 2) @default(0) @map("discount_amount")
  couponCode          String?       @map("coupon_code")
  stripePaymentIntent String?       @unique @map("stripe_payment_intent")
  stripeSessionId     String?       @map("stripe_session_id")
  status              OrderStatus   @default(PENDING)
  paymentStatus       PaymentStatus @default(PENDING) @map("payment_status")
  shippingAddress     Json          @map("shipping_address")
  trackingNumber      String?       @map("tracking_number")
  notes               String?
  installationDate    DateTime?     @map("installation_date")
  deliveredAt         DateTime? @map("delivered_at")
  serviceDueDate      DateTime?     @map("service_due_date")
  isGuest             Boolean       @default(false) @map("is_guest")
  isBacklog           Boolean       @default(false) @map("is_backlog")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  items               OrderItem[]
  serviceRequests     ServiceRequest[]

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("order_items")
}

model Testimonial {
  id           String   @id @default(uuid())
  content      String
  rating       Int      @default(5)
  authorName   String   @map("author_name")
  authorAvatar String?  @map("author_avatar")
  isApproved   Boolean  @default(false) @map("is_approved")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("testimonials")
}

model MarketingContent {
  id          String   @id @default(uuid())
  key         String   @unique
  title       String?
  subtitle    String?
  content     String?
  imageUrl    String?  @map("image_url")
  linkUrl     String?  @map("link_url")
  linkText    String?  @map("link_text")
  isActive    Boolean  @default(true) @map("is_active")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("marketing_content")
}

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  phone     String?
  source    String   @default("popup") // popup, newsletter, checkout
  createdAt DateTime @default(now()) @map("created_at")

  @@map("subscribers")
}

model MarketingSettings {
  id                 String    @id @default(uuid())
  popupEnabled       Boolean   @default(true) @map("popup_enabled")
  popupHeadline      String    @default("GET $50 OFF YOUR FIRST ORDER") @map("popup_headline")
  popupSubtext       String    @default("Join our community and get exclusive offers on water purification products.") @map("popup_subtext")
  discountCode       String    @default("WELCOME50") @map("discount_code")
  discountType       String    @default("fixed") @map("discount_type") // "percentage" or "fixed"
  discountValue      Decimal   @default(50) @db.Decimal(10, 2) @map("discount_value")
  popupDelay         Int       @default(5) @map("popup_delay") // seconds
  startDate          DateTime? @map("start_date")
  endDate            DateTime? @map("end_date")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("marketing_settings")
}

model Coupon {
  id               String    @id @default(uuid())
  code             String    @unique
  description      String?
  discountType     String    @default("percentage") @map("discount_type") // "percentage" or "fixed"
  discountValue    Decimal   @db.Decimal(10, 2) @map("discount_value") // percentage (e.g. 10) or fixed amount (e.g. 25.00)
  minOrderAmount   Decimal?  @db.Decimal(10, 2) @map("min_order_amount")
  maxDiscountAmount Decimal? @db.Decimal(10, 2) @map("max_discount_amount") // cap for percentage discounts
  maxUses          Int?      @map("max_uses")
  usedCount        Int       @default(0) @map("used_count")
  isActive         Boolean   @default(true) @map("is_active")
  startDate        DateTime? @map("start_date")
  endDate          DateTime? @map("end_date")
  applicableProductIds String[] @default([]) @map("applicable_product_ids")
  excludedProductIds   String[] @default([]) @map("excluded_product_ids")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("coupons")
}

enum EnquiryStatus {
  NEW_LEAD
  INTERESTED
  FOLLOW_UP
  NEED_MORE_INFO
  QUOTATION_SENT
  NEGOTIATION
  CONVERTED_TO_ORDER
  NO_RESPONSE
  NOT_INTERESTED
  LOST
  FUTURE_FOLLOW_UP
}

model Enquiry {
  id         String        @id @default(uuid())
  name       String
  email      String
  phone      String?
  subject    String
  message    String
  status     EnquiryStatus @default(NEW_LEAD)
  comment    String?
  resolvedAt DateTime?     @map("resolved_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@map("enquiries")
}

model PurchaseOrder {
  id                    String    @id @default(uuid())
  poNumber              String?   @map("po_number")
  poDate                DateTime? @map("po_date")
  vendorName            String?   @map("vendor_name")
  fileUrl               String?   @map("file_url")
  totalCost             Decimal?  @db.Decimal(10, 2) @map("total_cost")
  tax                   Decimal?  @db.Decimal(10, 2)
  deliveryStatus        String?   @default("PENDING") @map("delivery_status") // PENDING, IN_TRANSIT, DELIVERED
  deliveryReceivedDate  DateTime? @map("delivery_received_date")
  approvedBy            String?   @map("approved_by")
  paymentStatus         String?   @default("UNPAID") @map("payment_status") // UNPAID, PARTIAL, PAID
  notes                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  inventoryTransactions InventoryTransaction[]

  @@map("purchase_orders")
}

model Expense {
  id          String   @id @default(uuid())
  date        DateTime
  category    String
  amount      Decimal  @db.Decimal(10, 2)
  vendor      String?
  description String?
  receiptUrl  String?  @map("receipt_url")
  // sourceType / sourceId let an Expense row be auto-linked to another record
  // (currently: PurchaseOrder). Manual entries leave both null.
  sourceType  String?  @map("source_type")
  sourceId    String?  @map("source_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt       @map("updated_at")

  @@unique([sourceType, sourceId])
  @@index([date])
  @@index([category])
  @@map("expenses")
}

model InventoryTransaction {
  id              String   @id @default(uuid())
  productId       String   @map("product_id")
  product         Product  @relation(fields: [productId], references: [id])
  type            String   // "IN", "ADJUSTMENT", "ORDER"
  quantity        Int
  unitCost        Decimal? @db.Decimal(10, 2) @map("unit_cost")
  previousStock   Int      @map("previous_stock")
  newStock        Int      @map("new_stock")
  referenceType   String   @map("reference_type") // "PO", "ORDER", "MANUAL"
  referenceId     String?  @map("reference_id")
  purchaseOrder   PurchaseOrder? @relation(fields: [referenceId], references: [id])
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("inventory_transactions")
}

enum ServiceRequestStatus {
  PENDING
  IN_PROGRESS
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ServiceType {
  INSTALLATION
  MAINTENANCE
  REPAIR
  FILTER_REPLACEMENT
  INSPECTION
  WARRANTY_CLAIM
  OTHER
}

model ServiceRequest {
  id              String               @id @default(uuid())
  ticketNumber    String               @unique @map("ticket_number")
  orderId         String?              @map("order_id")
  order           Order?               @relation(fields: [orderId], references: [id])
  name            String
  email           String
  phone           String
  address         String?
  city            String?
  state           String?
  postcode        String?
  serviceType     ServiceType          @map("service_type")
  productName     String?              @map("product_name")
  purchaseDate    DateTime?            @map("purchase_date")
  issueDescription String              @map("issue_description")
  preferredDate   DateTime?            @map("preferred_date")
  status          ServiceRequestStatus @default(PENDING)
  priority        String               @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  assignedTo      String?              @map("assigned_to")
  internalNotes   String?              @map("internal_notes")
  resolution      String?
  scheduledDate   DateTime?            @map("scheduled_date")
  completedAt     DateTime?            @map("completed_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@map("service_requests")
}

model Category {
  id          String   @id @default(uuid())
  value       String   @unique // slug like "ro-purifiers"
  label       String   // display name like "RO Purifiers"
  description String?
  imageUrl    String?  @map("image_url")
  displayOrder Int     @default(0) @map("display_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

// Stock reservation for concurrent checkout protection
model StockReservation {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id") // unique identifier for checkout session
  productId   String   @map("product_id")
  quantity    Int
  expiresAt   DateTime @map("expires_at") // when the reservation expires (e.g., 10 minutes)
  orderId     String?  @map("order_id") // linked to order once payment succeeds
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([sessionId, productId])
  @@index([expiresAt])
  @@index([productId])
  @@map("stock_reservations")
}

enum EmploymentStatus {
  FULL_TIME
  PART_TIME
  CONTRACT
  CASUAL
}

model Employee {
  id               String           @id @default(uuid())
  // Admin-typed business key (e.g. EMP-001, JANE-D). Unique across the org.
  employeeId       String           @unique @map("employee_id")
  fullName         String           @map("full_name")
  email            String           @unique
  phone            String
  address          String?
  department       String
  position         String
  joiningDate      DateTime         @map("joining_date")
  employmentStatus EmploymentStatus @map("employment_status")
  // Free-text status the admin can set (e.g. "Active", "On leave", "Probation"). Soft-delete uses `isActive` below.
  currentStatus    String           @map("current_status")
  notes            String?
  // Soft delete: deleted employees stay in the DB for audit and only appear
  // in the admin when the "Show inactive" toggle is on.
  isActive         Boolean          @default(true) @map("is_active")
  documents        EmployeeDocument[]
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt       @map("updated_at")

  @@index([department])
  @@map("employees")
}

model EmployeeDocument {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  label      String
  url        String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([employeeId])
  @@map("employee_documents")
}
